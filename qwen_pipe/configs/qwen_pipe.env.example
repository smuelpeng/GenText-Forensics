# Copy values into your shell or a local .env file if needed.
# Do not commit real API keys.

DEBUG_DISTRIBUTION_ROOT=/Users/penpen/Documents/gentext-forensics/debug_distribution
PYTHON=python3
PIPELINE=staged
MODEL=qwen3.6-35b-a3b
MAX_SAMPLES=3
NUM_WORKERS=1
MAX_TOKENS=8192
# Base key for non-vector calls: verifier, VLM, visual reasoning.
API_KEY_FILE=/Users/penpen/Desktop/api-key.txt
# Semantic ranking key. The base key now supports text-embedding-v4.
SEMANTIC_API_KEY_FILE=/Users/penpen/Desktop/api-key.txt
OCR_LAYOUT_CACHE_MODEL=qwen-vl-ocr
REQUIRE_OCR_LAYOUT_CACHE=0

# Qwen-pipe bookkeeping.
LEDGER=outputs/tuning/experiments.jsonl
PRIMARY_METRIC=S_Fin_proxy
DECISION=candidate

# Cluster validation roots for the promoted v529 final-stage replay.
# QWEN_PIPE_ARTIFACT_ROOT should contain raw/, eval/, cache/, and diagnostics/.
QWEN_PIPE_ARTIFACT_ROOT=/path/to/qwen_pipe_artifacts
QWEN_PIPE_OUTPUT_ROOT=/path/to/cluster_outputs/qwen_pipe_v529
